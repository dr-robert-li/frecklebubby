# Frecklebubby settings. Copy this file to .env and fill in the values.
# compose.yaml reads .env. Without containers, `uv run frecklebubby` also reads .env from the current folder.
# Lines that start with # are comments. Do not put spaces around "=".

# ---------------------------------------------------------------------------
# Sign-in with Clerk (normal use)
# ---------------------------------------------------------------------------
# "clerk" is the safe default. The server does not start if a Clerk value below is empty.
AUTH_MODE=clerk

# Clerk dashboard > Configure > Domains, "Frontend API URL" without https://, for example clerk.example.com
CLERK_DOMAIN=
# Clerk dashboard > Configure > API keys > Publishable key (starts with pk_)
CLERK_PUBLISHABLE_KEY=
# Clerk dashboard > Configure > OAuth applications: the app for Claude and other MCP clients
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------
# The HTTPS address that people and Claude use to reach Frecklebubby, with no / at the end.
# Push notifications, the Claude connector and phone install need HTTPS.
BASE_URL=https://frecklebubby.example.com

# Optional: only these emails can sign in (comma list). Empty = anyone you invite or who signs in.
ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# AI model
# ---------------------------------------------------------------------------
# The bundled llama.cpp server in compose.yaml. Change only to use another OpenAI-compatible server.
# Each family can also change these in Settings > AI model.
LLM_BASE_URL=http://llama:8080/v1
# Empty = the model that the server gives.
LLM_MODEL=
# Empty = no key (the bundled server needs none).
LLM_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port on this computer (compose only). The app listens on 8000 inside the container.
FRECKLEBUBBY_PORT=8000
# Without containers only: where the app keeps its database and keys, and where it listens.
# In the container these are fixed: DATA_DIR=/data, HOST=0.0.0.0, PORT=8000.
# DATA_DIR=./data
# Optional sleep norms file (README "Sleep model"). Empty = DATA_DIR/sleep_norms.json.
# SLEEP_NORMS_PATH=
# Optional cry model files (README "Cry helper"). Empty = DATA_DIR/models/cry.
# CRY_MODEL_DIR=
# HOST=0.0.0.0
# PORT=8000

# ---------------------------------------------------------------------------
# Development only - WARNING
# ---------------------------------------------------------------------------
# AUTH_MODE=dev turns off sign-in: ANYONE who can reach the server can act as ANY user.
# Use it only on your own computer for testing. Never on a server that others can reach.
# AUTH_MODE=dev
# Dev mode only: a fake Huckleberry account for testing the import screen (set in the environment, not in .env).
# HUCKLEBERRY_FAKE=1
# Tests only: a folder with small replacement growth and milestone files.
# BUNDLED_DATA_DIR=
